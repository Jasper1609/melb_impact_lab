[
  {
    "name": "morning-briefing",
    "schedule": "0 7 * * *",
    "description": "Morning briefing — calendar, tasks, email, vault inbox",
    "prompt": "Pull the vault. Use the google MCP (listEvents tool) to list today's calendar events from all calendars. Run donebear today. Check Linear for issues assigned to me that are in progress or due soon. Count unprocessed inbox items (status: raw). Check for unread emails received overnight using listMessages. Check GitHub for PR reviews requested and new notifications. Give me a morning briefing in 5-8 sentences: calendar first, then tasks, then linear, email highlights, github, vault inbox count. Skip any section with nothing to report.",
    "platform": "whatsapp"
  },
  {
    "name": "calendar-reminder",
    "schedule": "*/15 8-20 * * 1-5",
    "description": "Pre-meeting reminder — events starting in the next 15-20 minutes",
    "prompt": "Use the google MCP (listEvents tool) to check for calendar events starting in the next 15 to 20 minutes across all calendars. If any exist, send a brief reminder with the event name, time, and location. If no upcoming events, produce no output at all.",
    "platform": "whatsapp"
  },
  {
    "name": "email-priority-alert",
    "schedule": "*/30 8-20 * * *",
    "description": "Priority email alert — check for urgent unread email",
    "prompt": "Use listMessages to check for unread emails received in the last 30 minutes. If any are from contacts I regularly correspond with or look urgent based on subject, send a brief alert with sender and subject. If nothing notable, produce no output at all.",
    "platform": "whatsapp"
  },
  {
