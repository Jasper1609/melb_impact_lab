    "prompt": "Pull the vault. Count inbox items with status: raw. If there are more than 5, tell me how many and suggest I process them. If 5 or fewer, say nothing.",
    "skill": "obsidian-vault",
    "platform": "whatsapp"
  },
  {
    "name": "task-triage",
    "schedule": "0 9 * * 1",
    "description": "Monday morning task triage — review overdue and unscheduled tasks",
    "prompt": "Run donebear today --json and donebear task list --json. Identify overdue tasks and tasks with no deadline. Summarise what needs attention this week.",
    "platform": "whatsapp"
  },
  {
    "name": "email-digest",
    "schedule": "0 18 * * 1-5",
    "description": "End-of-day email digest on weekdays",
    "prompt": "Use listMessages to get emails received today. Summarise them grouped by sender or topic. Highlight anything that looks like it needs a response. If any emails contain ideas or tasks worth capturing, suggest filing them to the vault inbox. Keep it to 5-10 sentences. If no emails today, say so in one sentence.",
    "platform": "whatsapp"
  },
  {
    "name": "weekly-vault-health",
