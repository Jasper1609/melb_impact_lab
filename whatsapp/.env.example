# WhatsApp (Baileys / WhatsApp Web emulation). Pair via QR after first deploy.
# Numbers: full international format, no '+', comma-separated.
# If empty and WHATSAPP_ALLOW_ALL_USERS=false, the bot rejects all messages.
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=
WHATSAPP_ALLOW_ALL_USERS=false
WHATSAPP_DEBUG=false

# Timezone (used by Hermes cron scheduler)
TZ=Australia/Melbourne

# LLM
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Vault repo (HTTPS URL, no embedded credentials)
VAULT_DIR=/vault
VAULT_REPO_URL=https://github.com/<owner>/<vault-repo>.git
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Hermes Bot
GIT_AUTHOR_EMAIL=hermes-bot@users.noreply.github.com

# Data lake repo (optional — cloned to /data-lake on boot, same credentials as vault)
DATA_LAKE_DIR=/data-lake
DATA_LAKE_REPO_URL=https://github.com/<owner>/<data-lake-repo>.git

# AgentMail (MCP server for sending/receiving email from a dedicated agent address)
AGENTMAIL_API_KEY=

# DoneBear (task management — GTD-style inbox, today, projects)
# Generate at https://donebear.com/settings or via: donebear api-key create "hermes" --workspaces personal
DONEBEAR_TOKEN=

# Linear (work tracking — issues, projects, status)
# Generate at https://linear.app/settings/api > Personal API Keys
LINEAR_API_KEY=

# Google Workspace (Gmail + Calendar via OAuth)
# One-time setup:
#   1. Create a Google Cloud project at https://console.cloud.google.com
#   2. Enable Gmail API and Google Calendar API
#   3. Create OAuth 2.0 credentials (Desktop app type)
#   4. Run locally: GOOGLE_CLIENT_ID="..." GOOGLE_CLIENT_SECRET="..." npx -y @a-bonus/google-docs-mcp auth
#   5. Copy the generated token to /opt/data/google-mcp-token.json on Railway volume
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hermes API server (bound to 0.0.0.0:$PORT for Railway healthcheck).
# IMPORTANT: Set API_SERVER_KEY to a strong random string in production.
# If left empty, the /v1/* API endpoints accept unauthenticated requests.
API_SERVER_ENABLED=true
API_SERVER_KEY=
