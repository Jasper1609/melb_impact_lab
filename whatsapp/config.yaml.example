model:
  provider: google
  default: gemini-3.5-flash

terminal:
  working_dir: /vault
  timeout: 60

whatsapp:
  unauthorized_dm_behavior: ignore
  reply_prefix: ""

session_reset:
  mode: idle
  idle_minutes: 1440

memory:
  memory_char_limit: 4400
  user_char_limit: 2750

skills:
  creation_nudge_interval: 10

agent:
  max_turns: 80
  reasoning_effort: medium

cron:
  enabled: true
  delivery_platform: whatsapp

# MCP servers follow Hermes best practice: tool surface kept minimal via
# tools.include allowlists where the skill docs name the exact tools used,
# and tools.resources/prompts disabled everywhere because no skill uses
# MCP resources or prompts (all skills call MCP tools directly).
# https://hermes-agent.nousresearch.com/docs/reference/mcp-config-reference
mcp_servers:
  # --- Outbound email ---
  agentmail:
    enabled: true
    command: "npx"
    args: ["-y", "agentmail-mcp"]
    env:
      AGENTMAIL_API_KEY: "${AGENTMAIL_API_KEY}"
    tools:
      resources: false
      prompts: false

  # --- Work tracking ---
  linear:
    enabled: true
    command: "npx"
    args: ["-y", "@hatcloud/linear-mcp"]
    env:
      LINEAR_API_KEY: "${LINEAR_API_KEY}"
    tools:
      include:
        - get_issue
        - list_issues
        - get_status_map
        - update_issue
        - create_issue
        - create_comment
        - create_document
      resources: false
      prompts: false

  github:
    enabled: true
    command: "npx"
    args: ["-y", "@modelcontextprotocol/server-github"]
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: "${GITHUB_TOKEN}"
    tools:
      include:
        - search_repositories
        - get_file_contents
        - create_or_update_file
        - push_files
        - create_issue
        - create_pull_request
        - search_issues
        - list_issues
        - get_issue
        - list_commits
        - get_pull_request
        - list_pull_requests
      resources: false
      prompts: false

  # --- Google Workspace (Gmail + Calendar via OAuth) ---
  google:
    enabled: true
    command: "npx"
    args: ["-y", "@a-bonus/google-docs-mcp"]
    env:
      GOOGLE_CLIENT_ID: "${GOOGLE_CLIENT_ID}"
      GOOGLE_CLIENT_SECRET: "${GOOGLE_CLIENT_SECRET}"
    tools:
      include:
        - listMessages
        - getMessage
        - sendEmail
        - createDraft
        - sendDraft
        - updateDraft
        - listDrafts
        - trashMessage
        - modifyMessageLabels
        - listLabels
        - triageInbox
        - listEvents
        - createEvent
        - deleteEvent
        - updateEvent
        - quickAddEvent
      resources: false
      prompts: false
