# WhatsApp (Baileys)
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=*
WHATSAPP_ALLOW_ALL_USERS=true
WHATSAPP_HOME_CHANNEL=dummy
WHATSAPP_DEBUG=false

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=

# OpenAI — used ONLY for text-embedding-3-small embeddings powering the
# Tapestry retrieval scripts (search_profiles, search_businesses, etc.).
# If unset, the embedding warm-up is skipped and retrieval calls fail loudly.
OPENAI_API_KEY=

# Timezone
TZ=Australia/Melbourne

# API server (healthcheck)
API_SERVER_ENABLED=true
API_SERVER_KEY=

# Tapestry data dir — where retrieval JSONs + embedding cache live on the
# Docker volume. Default works inside the container; rarely need to change.
BOT_DATA_DIR=/opt/data/tapestry
