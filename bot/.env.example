# WhatsApp (Baileys)
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=*
WHATSAPP_ALLOW_ALL_USERS=true
WHATSAPP_HOME_CHANNEL=dummy
WHATSAPP_DEBUG=false

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=

# Timezone
TZ=Australia/Melbourne

# API server (healthcheck)
API_SERVER_ENABLED=true
API_SERVER_KEY=

# Tapestry BE retrieval service — see bot/skills/tapestry-retrieval/SKILL.md
# host.docker.internal works for Docker Desktop on macOS and Windows.
# On Linux, use the host gateway (often 172.17.0.1) or set up a Docker network.
BE_URL=http://host.docker.internal:8765
