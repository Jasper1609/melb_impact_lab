model:
  provider: anthropic
  default: claude-sonnet-4-20250514

terminal:
  working_dir: /opt/data
  timeout: 60

whatsapp:
  unauthorized_dm_behavior: ignore
  reply_prefix: ""

display:
  platforms:
    whatsapp:
      tool_progress: "off"
      show_reasoning: false
      tool_preview_length: 0
  busy_input_mode: queue

stt:
  enabled: true
  provider: local
  local:
    model: base

session_reset:
  mode: idle
  idle_minutes: 1440

memory:
  memory_char_limit: 4400
  user_char_limit: 2750

skills:
  creation_nudge_interval: 0

agent:
  max_turns: 80
  reasoning_effort: medium

onboarding:
  seen:
    busy_input_prompt: true
    tool_progress_hint: true
    sethome_hint: true
